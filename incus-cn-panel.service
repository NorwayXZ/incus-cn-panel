[Unit]
Description=Incus 中文集群控制面板
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/incus-cn-panel/config.env
ExecStart=/usr/bin/python3 /opt/incus-cn-panel/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/etc/incus-cn-panel/incus-client /var/lib/incus-cn-panel

[Install]
WantedBy=multi-user.target
